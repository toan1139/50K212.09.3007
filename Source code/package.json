{
  "name": "me-e-digitalcam",
  "version": "1.0.0",
  "description": "ME.E DIGITALCAM – hệ thống cho thuê máy ảnh tại Đà Nẵng (FE + BE + Database)",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --no-warnings server/index.js",
